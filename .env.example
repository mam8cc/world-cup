# Postgres connection string. Local docker default below; use Neon URL in production.
DATABASE_URL="postgresql://worldcup:worldcup@localhost:5433/worldcup"

# World Cup season the app scores against (matches OpenFootball dataset folder).
WC_SEASON="2026"

# Secret required to trigger the scoring cron endpoint (Vercel Cron sets this via header).
CRON_SECRET="dev-cron-secret"
